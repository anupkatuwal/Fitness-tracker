# --- Application ---
# "production" makes the app refuse to start with an unsafe SECRET_KEY,
# and hands schema ownership to Alembic instead of create_all.
VANGUARD_ENVIRONMENT=development

# REQUIRED in production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Minimum 32 characters. Anyone who knows this value can forge a login token.
VANGUARD_SECRET_KEY=replace-with-a-long-random-value-see-command-above
VANGUARD_ACCESS_TOKEN_EXPIRE_MINUTES=1440
VANGUARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Microsoft SQL Server 2022 ---
VANGUARD_DB_DRIVER=ODBC Driver 18 for SQL Server
VANGUARD_DB_HOST=localhost
VANGUARD_DB_PORT=1433
VANGUARD_DB_NAME=VanguardFitness
VANGUARD_DB_USER=sa
VANGUARD_DB_PASSWORD=YourStrong@Passw0rd
VANGUARD_DB_TRUST_SERVER_CERTIFICATE=true
VANGUARD_DB_ECHO=false

# Set to true to use a local SQLite file instead of SQL Server (dev/CI only).
VANGUARD_USE_SQLITE=false
VANGUARD_SQLITE_PATH=./vanguard_fitness.db

# Overrides everything above when set.
# VANGUARD_DATABASE_URL=

# --- Rate limiting (per user, on the outbound OpenFoodFacts endpoints) ---
# Counted in-process: with N Uvicorn workers the effective limit is N x this.
VANGUARD_OPENFOODFACTS_RATE_LIMIT_REQUESTS=30
VANGUARD_OPENFOODFACTS_RATE_LIMIT_WINDOW_SECONDS=60

# --- OpenFoodFacts ---
VANGUARD_OPENFOODFACTS_BASE_URL=https://world.openfoodfacts.org
VANGUARD_OPENFOODFACTS_USER_AGENT=VanguardFitness/1.0 (https://github.com/anupkatuwal/fitness-tracker)
VANGUARD_OPENFOODFACTS_TIMEOUT_SECONDS=12
